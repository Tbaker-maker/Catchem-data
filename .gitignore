# local backups / scratch
*.bak
.__*-shim.mjs

# Credentials never enter this repo. The cheapest control that exists, and the
# most common way a secret gets in is a file nobody meant to add.
.env
.env.*
*.pem
*.key
node_modules/

# Raw enrichment payloads: 166MB for 861 cards (~3GB at catalogue scale).
# Regenerable from the API; the distilled file is what instruments read.
data/enrichment-by-set.json
