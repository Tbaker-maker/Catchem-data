  "dash": {
    "allow": "\\b[A-Z]{1,5}[\\u2014\\u2013][A-Z]"
  },
  "promises": [
    {
      "id": "guaranteed",
      "pattern": "\\bguarantee(?:d|s)?\\b",
      "negatable": true,
      "reason": "Promises a result. Prices can always move either way."
    },
    {
      "id": "cant-lose",
      "pattern": "\\b(?:can['’]?t|cannot|can not) (?:lose|go wrong|miss)\\b",
      "negatable": false,
      "reason": "Promises a result. Prices can always move either way."
    },
    {
      "id": "will-double",
      "pattern": "\\bwill (?:double|triple|quadruple|10x|explode|skyrocket|moon|only go up|go up|keep (?:going up|climbing)|be worth (?:more|a lot|a fortune|\\$))",
      "negatable": true,
      "reason": "Predicts a price as fact. Say what the price did, with its dates."
    },
    {
      "id": "will-hit",
      "pattern": "\\b(?:price|it|this|they|value) (?:will|is going to|gonna) (?:hit|reach|clear|pass|break) \\$?\\d[\\d,.]*k?",
      "negatable": true,
      "reason": "Names a future price as fact. Say what the price did, with its dates."
    },
    {
      "id": "easy-money",
      "pattern": "\\b(?:easy|free|quick|fast) (?:money|profit|profits|flip|flips|gains?)\\b",
      "negatable": true,
      "reason": "Promises a return. Describe the listings and prices instead."
    },
    {
      "id": "risk-free",
      "pattern": "\\brisk[- ]free\\b|\\bno risk\\b|\\bzero risk\\b|\\bsafe bet\\b|\\bsure thing\\b",
      "negatable": false,
      "reason": "Promises there is no risk. Prices can always move either way."
    },
    {
      "id": "to-the-moon",
      "pattern": "\\bto the moon\\b|\\bmooning\\b|\\bmoon soon\\b",
      "negatable": false,
      "reason": "Hype that promises a climb. Say the real change and dates instead."
    }
  ],
  "framing": [
    {
      "id": "crypto",
      "kind": "crypto",
      "pattern": "\\b(?:crypto|cryptos|cryptocurrency|cryptocurrencies|bitcoin|btc|ethereum|nft|nfts|web3|blockchain|hodl|altcoins?|memecoins?|defi|airdrops?)\\b",
      "reason": "Crypto words are kept out of Catch'em copy."
    },
    {
      "id": "investment",
      "kind": "framing",
      "pattern": "\\b(?:good|great|solid|smart|safe|best|sound|wise|long[- ]term|real) investments?\\b|\\binvestment (?:opportunity|opportunities|grade|piece|pieces|potential|vehicle|play|advice)\\b|\\bas an investment\\b|\\binvest(?:ing)? in\\b|\\bstore of value\\b|\\bpassive income\\b",
      "reason": "Frames cards as an investment. Describe the listings and prices instead."
    },
    {
      "id": "buy-call",
      "kind": "advice",
      "pattern": "\\b(?:must[- ]buys?|strong (?:buy|sell)|instant buy|auto[- ]buy|buy rating|sell rating|buy the dip)\\b",
      "reason": "Calls a buy or sell for the reader. Describe the listings and prices instead."
    }
  ],
  "reasons": {
    "directive": "Tells the reader what to do with their money. Describe the listings and prices instead.",
    "imperative": "Tells the reader to buy or sell. Describe the listings and prices instead.",
    "dash": "No em or en dashes in copy. Use a comma, period, colon or parentheses."
  }
}
